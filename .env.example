# ── Local dev ────────────────────────────────────────────────────────────────
PORT=12800
DATA_DIR=./data

# CONSOLE_JWT_SECRET=           # optional; generated and persisted securely on first run
CONSOLE_PASSWORD=             # required only for first production startup (any non-empty, non-placeholder value)
BOOTSTRAP_PROXY_API_KEY=      # optional bootstrap API key (any non-empty, non-placeholder value)
BOOTSTRAP_PROXY_API_KEY_NAME=bootstrap
#
# Console browser origin. This local default matches the backend and the Vite
# proxy target; use the exact public URL in production.
PUBLIC_ORIGIN=http://127.0.0.1:12800
# Console API intentionally does not enable wildcard CORS.
# TRUST_PROXY=false
#   rate_limit_rpm, daily_token_limit, monthly_token_limit,
#   max_concurrent_requests, provider_allowlist, model_allowlist, model_denylist

# ── Optional (safe defaults, uncomment to override) ──────────────────────────
DISABLE_LANDING_PAGE=false          # serve the console directly at the root path when true
# MAX_FLIGHTS_PER_IP=15              # global concurrent requests per IP; leave commented for the default
# Bootstrap proxy key receives a 120 RPM personal limit on first startup.
# API-key RPM/concurrency limits are configured per key in the API Keys edit modal.
# CONSOLE_MUTATION_MAX=30             # max mutations per window per session
# CONSOLE_MUTATION_WINDOW_MS=10000    # sliding window length in milliseconds
# DB_PATH=
# RUNTIME_DB_PATH=
# ASSET_DIR=

# ── Bounded runtime memory controls ──────────────────────────────────────────
# These 0 values derive tracker caps from available memory.
# CARTETHYIA_MAX_TRACKED_IPS=0        # per-IP flight tracker cap; 0 = adaptive from RSS
# CARTETHYIA_MAX_TRACKED_KEYS=0       # API key admission tracker cap; 0 = adaptive from RSS
# CARTETHYIA_LOGIN_MAX_TRACKED_IPS=0  # login rate limiter IP cap; 0 = adaptive from RSS
#
# Periodic non-blocking GC request. It waits for an idle point (in-flight == 0).
# CARTETHYIA_GC_INTERVAL_MS=600000    # 10 minutes; 0 uses the same 10-minute fallback
# CARTETHYIA_REQUEST_LOGS=0            # disable request log writes for high-throughput deployments

# Codex ChatGPT is direct by default; set true only when an outbound proxy is explicitly configured for Codex.
# CARTETHYIA_CODEX_PROXY=false
# Free proxy scraper health-check workers (default 20, hard cap 64).
# CARTETHYIA_PROXY_SCRAPE_CONCURRENCY=20

# ── Go daemon / Laragon local verification ───────────────────────────────────
# The Go daemon reads these process variables directly. PostgreSQL and Redis
# are expected on the default Laragon local ports.
CARTETHYIA_LISTEN_ADDRESS=:12800
CARTETHYIA_ENV=development
CARTETHYIA_DATABASE_URL=postgres://postgres@127.0.0.1:5432/cartethyia?sslmode=disable
CARTETHYIA_REDIS_URL=redis://127.0.0.1:6379/0
# Required whenever CARTETHYIA_DATABASE_URL is set; use a unique local secret.
CARTETHYIA_ENCRYPTION_KEY=replace-with-at-least-16-random-bytes
CARTETHYIA_REQUEST_TIMEOUT=2m
CARTETHYIA_READ_HEADER_TIMEOUT=10s
CARTETHYIA_CONNECT_TIMEOUT=10s
CARTETHYIA_FIRST_BYTE_TIMEOUT=30s
CARTETHYIA_IDLE_TIMEOUT=60s
CARTETHYIA_STREAM_IDLE_TIMEOUT=60s
CARTETHYIA_STREAM_TOTAL_TIMEOUT=2m
CARTETHYIA_SHUTDOWN_TIMEOUT=10s
CARTETHYIA_USAGE_RETENTION=720h
CARTETHYIA_MAX_BODY_BYTES=16777216
CARTETHYIA_MAX_HEADER_BYTES=1048576
CARTETHYIA_MAX_OUTPUT_TOKENS=1048576
CARTETHYIA_MAX_CONCURRENT=256
CARTETHYIA_MAX_CONCURRENT_STREAMS=256

# Optional Docker Compose overrides. Compose defaults to its service DNS names;
# set these only when PostgreSQL or Redis run outside the Compose network.
# CARTETHYIA_COMPOSE_DATABASE_URL=postgres://cartethyia:cartethyia@postgres:5432/cartethyia?sslmode=disable
# CARTETHYIA_COMPOSE_REDIS_URL=redis://redis:6379/0

# ── Dashboard auxiliary server (bun run server from dashboard/) ──────────────
# Serves /internal/* only: the browser error-report sink (SQLite) and a
# Postgres health probe. Never exposed publicly; nginx/Vite proxy /internal
# to it.
# CARTETHYIA_DASHBOARD_SERVER_PORT=8787     # aux server listen port (default 8787)
# CARTETHYIA_DASHBOARD_DATABASE_URL=        # Postgres DSN for aux migrations + health (pg defaults to localhost:5432 when unset)
# CARTETHYIA_DASHBOARD_SQLITE_PATH=data/logs.db  # SQLite file for the /internal/logs sink
