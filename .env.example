# ── Local dev ────────────────────────────────────────────────────────────────
PORT=12800
DATA_DIR=./data

# ── Required (console + proxy access) ───────────────────────────────────────
# CONSOLE_JWT_SECRET=           # auto-generated on first run if unset
CONSOLE_PASSWORD=change-me
BOOTSTRAP_PROXY_API_KEY=change-me
BOOTSTRAP_PROXY_API_KEY_NAME=default
#
# Per-key limits & ACL (set via console after creation):
#   rate_limit_rpm, daily_token_limit, monthly_token_limit,
#   max_concurrent_requests, provider_allowlist, model_allowlist, model_denylist

# ── Optional (safe defaults, uncomment to override) ──────────────────────────
DISABLE_LANDING_PAGE=false          # serve the console directly at the root path when true
# MAX_FLIGHTS_PER_IP=15              # global concurrent requests per IP; leave commented for the default
# Bootstrap proxy key receives a 120 RPM personal limit on first startup.
# API-key RPM/concurrency limits are configured per key in the API Keys edit modal.
# CONSOLE_MUTATION_MAX=30             # max mutations per window per session
# CONSOLE_MUTATION_WINDOW_MS=10000    # sliding window length in milliseconds
# DB_PATH=
# RUNTIME_DB_PATH=
# ASSET_DIR=

# ── Adaptive scaling (all default to 0 = auto-derive from available memory) ──
# CARTETHYIA_MAX_TRACKED_IPS=0        # per-IP flight tracker cap; 0 = adaptive from RSS
# CARTETHYIA_MAX_TRACKED_KEYS=0       # API key admission tracker cap; 0 = adaptive from RSS
# CARTETHYIA_LOGIN_MAX_TRACKED_IPS=0  # login rate limiter IP cap; 0 = adaptive from RSS
# CARTETHYIA_GC_INTERVAL_MS=0         # GC interval in ms; 0 = fallback 10 min (GC itself defers to idle points)
