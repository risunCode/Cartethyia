# Cartethyia local environment template.
# Copy to .env for native development and replace placeholder secrets.
# Keep this file as a readable starting point: common runtime values come
# first, feature-specific overrides stay beside the feature they configure.
# Leave commented settings unset unless you intentionally need that behavior.

# Server and dashboard
# --------------------
# On a PaaS (Railway, Fly, Render) leave PORT unset: the platform injects its
# own PORT and routes the public domain to the port the app binds. Pinning it
# here overrides the injected value and fights the domain's target port.
PORT=12800
NODE_ENV=development
DASHBOARD_DIST=./dist/dashboard
# Required only for OAuth redirect flows. Local default:
# http://localhost:12800
CARTETHYIA_PUBLIC_ORIGIN=http://localhost:12800

# Optional override for the version the console reports at
# `/console/api/system/health`. When omitted, that response reports the bundled
# package version from `package.json`. This override does not change the
# upstream `Cartethyia/<version>` User-Agent, which always carries the bundled
# package version.
# CARTETHYIA_VERSION=0.0.0

# Logging
# -------
# One of trace, debug, info, warn, error, or fatal. Defaults to debug in
# development and info in production.
# LOG_LEVEL=info

# Database and application secrets
# ---------------------------------
# PostgreSQL may be local (Laragon/Homebrew/systemd), external, or the Compose
# `postgres` service. In Docker, the hostname must be reachable from inside the
# app container: the Compose stack sets the app's DATABASE_URL to the service
# name, so this value is only used when you run the app outside that stack.
# On Railway, reference the Postgres service: DATABASE_URL=${{ Postgres.DATABASE_URL }}.
DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/cartethyia

# Checked only when DATABASE_URL is unset or empty.
# DATABASE_PRIVATE_URL=
# DATABASE_PUBLIC_URL=
# PGHOST=
# PGPORT=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Cartethyia encryption key for provider credentials and API-key hashing.
# Use a random 32-byte value: openssl rand -base64 32
CARTETHYIA_ENCRYPTION_KEY=replace-with-cartethyia-encryption-key

# Default local Cartethyia API key. During first-boot setup it is hashed with
# CARTETHYIA_ENCRYPTION_KEY and stored as a normal tenant-scoped API key.
CARTETHYIA_API_KEY=replace-with-cartethyia-api-key

# Database pool and coordination
# ------------------------------
# Connections per gateway process, opened on demand (this is a ceiling, not a
# reservation). The proxy path is mostly database-free — routing is served from
# an in-process snapshot and admission counters live in Redis — but not
# entirely: a dispatch attempt resolves its own credential, writes health
# transitions, and reads tenant preferences behind a short cache. The larger
# consumers are the console API, one telemetry flush, the worker sweeps, auth,
# and readiness. Keep DATABASE_POOL_MAX * (number of gateway
# processes) below the server's `max_connections` (Postgres defaults to 100);
# boot logs the process count that fits, and refuses a pool that alone exceeds
# the server ceiling.
# DATABASE_POOL_MAX=20
# normal       = Redis-backed coordination; REDIS_URL is required
# single_instance_local = bounded in-memory coordination; Redis is not needed
REDIS_MODE=normal
# On Railway, reference the Redis service: REDIS_URL=${{ Redis.REDIS_URL }}
# (also private-network by default; REDIS_PUBLIC_URL is the external one).
REDIS_URL=redis://localhost:6379

# Checked only when REDIS_URL is unset or empty.
# REDIS_PUBLIC_URL=
# REDISHOST=
# REDISPORT=
# REDISUSER=
# REDISPASSWORD=

# Native-first setup
# ------------------
# Docker is opt-in: setting CARTETHYIA_SETUP_MODE=docker starts the Compose
# PostgreSQL and Redis helper services. Otherwise setup uses locally installed
# services through the DATABASE_URL/REDIS_URL configured above.
CARTETHYIA_SETUP_MODE=auto
# To use the Compose helpers explicitly, set CARTETHYIA_SETUP_MODE=docker.

# Database and server safety overrides
# ------------------------------------
# Defaults are 30s, 60s, and 5s respectively.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TXN_TIMEOUT_MS=60000
# DATABASE_LOCK_TIMEOUT_MS=5000
# Telemetry payload storage (off by default; request metadata remains in telemetry_events)
# ------------------------------------------------------------------------------------
# Explicitly opted-in payload bodies are stored in bounded local .jsonb frames.
# Retention defaults to 15 minutes and the cleanup scheduler runs every 15 minutes.
# The directory must exist and be writable by the container's runtime user
# (uid 10001). With a bind mount the host directory's ownership wins over the
# image's, so prepare it once:  mkdir -p ./data && chown -R 10001:10001 ./data
# Without that, capture fails for every request while the console still shows
# the switch as On — the gateway logs one warning naming this directory.
# CARTETHYIA_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads
# CARTETHYIA_TELEMETRY_PAYLOAD_FILE_MAX_BYTES=67108864
# CARTETHYIA_TELEMETRY_PAYLOAD_RETENTION_MS=900000
# Metadata-only request telemetry retention (default 30 days; usage periods up to 30d stay complete).
# Payload capture is off by default per tenant; opt in via Console Settings only when debugging.
# CARTETHYIA_TELEMETRY_RETENTION_DAYS=30

# Provider installation identity
# ------------------------------
# Claude, Codex, and Grok each stamp a stable per-installation id on their
# upstream requests. It is written to `$HOME/.cartethyia` by default, which
# breaks in the container: the process drops to uid 10001 via `setpriv` without
# changing `HOME`, so it still points at `/root` and every write fails with
# EACCES. Point this at a writable directory to keep one identity across
# restarts. When unset, a non-writable home falls back to `./data/.cartethyia`
# and, failing that, to an id that lasts only for the process (with one warning)
# — the id is a telemetry hint, so it never fails a request.
# CARTETHYIA_INSTALL_ID_DIR=/app/data/.cartethyia

# Defaults are 60s and 8 MiB respectively.
# CARTETHYIA_SERVER_IDLE_TIMEOUT=60
# CARTETHYIA_SERVER_MAX_BODY_BYTES=8388608

# Graceful-shutdown drain window (ms). On SIGTERM/SIGINT the process stops
# admitting new work, lets in-flight requests finish naturally for this long,
# then aborts the stragglers (a draining stream is told via a terminal frame
# rather than a silent close). Default 20000; 0 aborts immediately.
# CARTETHYIA_SHUTDOWN_DRAIN_WINDOW_MS=20000

# Optional secret enabling the operator drain endpoint `POST /admin/drain`
# (loopback peer + `x-drain-token` header, compared in constant time). It is a
# signal-free graceful stop for platforms where a catchable signal cannot be
# delivered to the process (notably Windows). Unset = the route does not exist.
# CARTETHYIA_DRAIN_TOKEN=

# Process memory limit used for the >80% usage warning on /metrics. Detected
# automatically from cgroup v1/v2 inside containers; set explicitly for native
# deployments that want the warning. When RSS exceeds 80% of it the sampler
# also runs an asynchronous garbage collection, at most once per minute.
# CARTETHYIA_MEMORY_LIMIT_BYTES=536870912

# Bun garbage-collection tuning (optional; Bun already sizes the heap from
# available memory and cgroup limits).
# `--smol` makes the collector run more frequently to cap memory growth, at
# some CPU cost — useful in memory-constrained containers. BUN_OPTIONS is
# honored by the compiled binary as well as `bun run`.
# BUN_OPTIONS=--smol
# Force GC frequency: 0 = default, 1 = async GC more often, 2 = sync GC more
# often (aggressive; intended for debugging, not production).
# BUN_GARBAGE_COLLECTOR_LEVEL=1

# Per-IP gateway rate limit (requests per rolling window). Only enforced on
# /v1/*; defaults to 240 when unset.
# IP_RATE_MAX_PER_WINDOW=240

# Graduated model-abuse strikes. A caller that requests a model outside its
# access — a model not in its allowlist, or one that resolves to nothing — is
# warned, and its client address banned after this many *consecutive* such
# requests. Only the address is banned, never the API key: a key can be shared
# by every recipient of a share link, so a key ban would punish callers that did
# nothing. A valid-model request resets the count, and a strike expires after the
# window, so one typo never accumulates toward a ban. A ban lapses on its own
# after the TTL; the console can also lift one early.
# Defaults: threshold 10, window 300000 (5 min), ban TTL 3600000 (1 h).
# CARTETHYIA_MODEL_STRIKE_THRESHOLD=10
# CARTETHYIA_MODEL_STRIKE_WINDOW_MS=300000
# CARTETHYIA_MODEL_BAN_TTL_MS=3600000

# Proxy and outbound SSRF policy
# -----------------------------
# When traffic arrives through cloudflared locally, trust its loopback peer:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# For a PaaS edge (Railway, Fly, Render) set the single value `platform`. The
# edge terminates TLS and the container has no public address, so every request
# arrives through it and the peer is an edge node whose CIDR is not published or
# stable. Only do this where the container is unreachable except through the
# edge: `platform` trusts the forwarding headers from any peer, so a deployment
# that exposes its own port would let a caller forge its client IP.
# TRUSTED_PROXY_CIDRS=platform
# In trusted mode the gateway honors CF-Connecting-IP, True-Client-IP,
# X-Forwarded-For, then X-Real-IP; the raw peer is always used otherwise.
# Unset means `disabled`: the TCP peer is the client and the headers are ignored.
# Private upstreams are ALLOWED by default: this is a flag, enabled unless the
# literal `false` is set, so leaving it unset permits a provider base URL that
# resolves into a private range. Set it to `false` to block loopback, link-local,
# and private destinations — do that whenever every upstream is public. Narrow
# the permitted ranges instead with CARTETHYIA_ALLOWED_NETWORKS when a deployment
# legitimately reaches some private upstreams but not all.
# CARTETHYIA_ALLOW_PRIVATE_UPSTREAMS=true
# CARTETHYIA_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# CARTETHYIA_MAX_REDIRECTS=3

# Upstream request timeout and retry backoff
# ------------------------------------------
# Wall-clock bound for one proxied request, ingress to terminal upstream event,
# including candidate failover. Defaults to the previously hardcoded 120s. For
# a streaming response it bounds the pre-stream phase; once the body is
# established the deadline is re-armed to this value plus the stall budget, so
# the stream watchdogs below govern body duration.
# CARTETHYIA_UPSTREAM_TIMEOUT_MS=120000
# Max silence between upstream stream events before the stream is declared
# stalled (504). Default 360s, above legitimate long reasoning silences. The
# pool-slot crash-recovery TTL is derived from this value plus the request
# deadline, so the watchdog releases the lease before the sweep can reclaim it.
# WARNING: the minimum is 60s, but Codex/o1-style hidden reasoning can hold
# ~5min silence. Lowering this toward the floor induces false 504s on
# legitimate reasoning turns; only lower it if no reasoning workload flows
# through this deployment.
# CARTETHYIA_STREAM_STALL_TIMEOUT_MS=360000
# Max time to the first client-visible stream chunk (TTFB). Default 200s; after
# the first upstream activity (even surface-invisible reasoning deltas) the
# longer stall bound applies instead.
# CARTETHYIA_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
# Candidate-failover backoff: full-jitter exponential between base and cap.
# CARTETHYIA_FALLBACK_RETRY_BASE_MS=100
# CARTETHYIA_FALLBACK_RETRY_CAP_MS=2000

# Account and proxy-pool health cooldowns
# --------------------------------------
# Fallback backoffs used only when the upstream error states no reset window;
# an upstream `Retry-After`/`x-ratelimit-reset` header or a duration quoted in
# the provider message always wins. Every one of these parks the account in
# `cooldown`: rate-limit, quota, and model-capacity failures, and the
# transport-shaped ones (5xx, network, timeout, unclassified) that no rule
# classified further. Only a rejected credential reaches `disabled`, which is a
# hard routing exclusion, so no backoff here can produce it. xAI Grok Build
# free-tier exhaustion is pinned to its rolling 24-hour window regardless of
# these values.
# CARTETHYIA_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000
# CARTETHYIA_ACCOUNT_QUOTA_COOLDOWN_MS=3600000
# CARTETHYIA_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000
# CARTETHYIA_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000
# CARTETHYIA_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=60000
# How long a proxy pool stays `cooldown` after a transport fault.
# CARTETHYIA_POOL_COOLDOWN_MS=120000


# Provider OAuth hosts
# --------------------
# Override Kimi's OAuth origin for self-hosted or regional gateways.
# CARTETHYIA_KIMI_OAUTH_HOST=https://auth.kimi.com

# GitHub Enterprise domain for the GitHub Copilot device login (blank = github.com).
# An enterprise account is served from its own GitHub domain, so an operator on
# one must point the login at it.
# CARTETHYIA_GITHUB_ENTERPRISE_DOMAIN=company.ghe.com
# Override the Kimi Code quota/billing base URL for regional gateways.
# CARTETHYIA_KIMI_QUOTA_BASE_URL=https://api.kimi.com/coding/v1

# Proxy pool agents
# -----------------
# HTTP(S) CONNECT and SOCKS5 agents share these socket limits. Pool egress is
# dialed in-process; there is no child-process pool flavor to configure.
# CARTETHYIA_PROXY_MAX_SOCKETS=100
# CARTETHYIA_PROXY_MAX_FREE_SOCKETS=20

# Dashboard development settings
# ------------------------------
# Vite defaults to http://127.0.0.1:12800 when this is unset.
# VITE_BACKEND_URL=http://127.0.0.1:12800

# Isolated test database
# ----------------------
# Gates the DB-dependent suites AND routes them at this database, so test
# fixtures never land in DATABASE_URL. Leave unset to skip those suites.
# CARTETHYIA_TEST_DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/cartethyia_test

# Isolated test Redis
# -------------------
# Gates the live TTL suites (`test/security/admission-ttl.test.ts`). Those read
# `TTL` and lease state, which is server state a fake cannot witness, so they
# need a real server. Point this at a dedicated database index rather than the
# one REDIS_URL uses — the suite namespaces its own keys, but a separate index
# keeps a `FLUSHDB`-style cleanup in one suite from touching live data.
# Leave unset to skip the TTL suites.
# CARTETHYIA_TEST_REDIS_URL=redis://127.0.0.1:6379/15
