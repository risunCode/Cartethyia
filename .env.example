# ── Required ──────────────────────────────────────────────────────────────────
CONSOLE_PASSWORD=change-me
CONSOLE_JWT_SECRET=replace-with-a-long-random-secret

# ── Local dev (override in production) ──────────────────────────────────────
PORT=12800
DATA_DIR=./data

# ── Server ──────────────────────────────────────────────────────────────────
MAX_FLIGHTS_PER_IP=20
TRUST_PROXY=false
CACHE_MARKERS_ENABLED=true

# ── Proxy API keys ──────────────────────────────────────────────────────────
BOOTSTRAP_PROXY_API_KEY=change-me
BOOTSTRAP_PROXY_API_KEY_NAME=default
#
# Per-key limits & ACL (set via console after creation):
#   rate_limit_rpm, daily_token_limit, monthly_token_limit,
#   max_concurrent_requests, provider_allowlist, model_allowlist, model_denylist

# ── Runtime retention & tracking ─────────────────────────────────────────────
LOG_RETENTION_DAYS=14
ASSET_RETENTION_DAYS=7
TRACK_PAYLOADS=store             # none | meta | store
TRACK_ASSETS=meta                # none | meta | store

# =============================================================================
# Optional / advanced overrides — uncomment only if you need them
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=
# STREAM_STALL_TIMEOUT_MS=30000

# ── Console ─────────────────────────────────────────────────────────────────
# CONSOLE_PATH=/console
# CONSOLE_ENABLED=true
# CONSOLE_SESSION_TTL_HOURS=12

# ── Proxy API keys ──────────────────────────────────────────────────────────
# PROXY_AUTH_MODE=api_key          # open | api_key

# ── Advanced path overrides ─────────────────────────────────────────────────
# DB_PATH=
# RUNTIME_DB_PATH=
# ASSET_DIR=
