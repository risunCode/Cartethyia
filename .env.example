# Cartethyia environment variables — only variables the code actually reads.
#
# Go router:  router/internal/config/config.go (FromEnvironment)
# Bootstrap:  CONSOLE_PASSWORD (router/internal/runtime/bootstrap.go)
# Dashboard:  dashboard/vite.config.ts
# Compose:    docker-compose.yml interpolates the CARTETHYIA_COMPOSE_* names
#             from this file; they are never read by the daemon process.

# ── Go daemon core ────────────────────────────────────────────────────────────
CARTETHYIA_LISTEN_ADDRESS=:12800
CARTETHYIA_ENV=development
# Postgres DSN; empty keeps the daemon on bounded in-process storage.
CARTETHYIA_DATABASE_URL=postgres://postgres@127.0.0.1:5432/cartethyia?sslmode=disable
# Redis DSN; empty disables the shared cache backend.
CARTETHYIA_REDIS_URL=redis://127.0.0.1:6379/0
# Required whenever CARTETHYIA_DATABASE_URL is set; use a unique local secret.
CARTETHYIA_ENCRYPTION_KEY=replace-with-at-least-16-random-bytes
# Set true ONLY when a trusted reverse proxy is the daemon's sole direct
# client; it makes the login rate limiter honor X-Forwarded-For.
# CARTETHYIA_TRUST_PROXY=false
# Set true to enable hedged upstream attempts (races a second account after
# a slow first byte). Read at daemon bootstrap, not by config.go.
# CARTETHYIA_ENABLE_HEDGING=false

# ── Go daemon optional overrides (safe defaults shown) ────────────────────────
# CARTETHYIA_REQUEST_TIMEOUT=2m
# CARTETHYIA_READ_HEADER_TIMEOUT=10s
# CARTETHYIA_CONNECT_TIMEOUT=10s
# CARTETHYIA_FIRST_BYTE_TIMEOUT=30s
# CARTETHYIA_IDLE_TIMEOUT=60s
# CARTETHYIA_STREAM_IDLE_TIMEOUT=60s
# CARTETHYIA_STREAM_TOTAL_TIMEOUT=2m
# CARTETHYIA_SHUTDOWN_TIMEOUT=10s
# CARTETHYIA_USAGE_RETENTION=720h
# CARTETHYIA_MAX_BODY_BYTES=16777216
# CARTETHYIA_MAX_HEADER_BYTES=1048576
# CARTETHYIA_MAX_OUTPUT_TOKENS=1048576
# CARTETHYIA_MAX_CONCURRENT=256
# CARTETHYIA_MAX_CONCURRENT_STREAMS=256

# Legacy aliases accepted by the daemon config loader (the CARTETHYIA_*
# spelling above wins when both are set):
# LISTEN_ADDRESS=, NODE_ENV=, DATABASE_URL=, REDIS_URL=,
# ACCOUNT_ENCRYPTION_KEY= (or CARTETHYIA_ACCOUNT_ENCRYPTION_KEY=)

# ── Console bootstrap ─────────────────────────────────────────────────────────
# Required only for the first production startup (any non-empty value).
# CONSOLE_PASSWORD=

# ── Docker Compose interpolation ─────────────────────────────────────────────
# Compose defaults to its service DNS names; set these only when PostgreSQL
# or Redis run outside the Compose network.
# CARTETHYIA_COMPOSE_DATABASE_URL=postgres://cartethyia:cartethyia@postgres:5432/cartethyia?sslmode=disable
# CARTETHYIA_COMPOSE_REDIS_URL=redis://redis:6379/0

# ── Dashboard local dev (vite.config.ts) ──────────────────────────────────────
# CARTETHYIA_DASHBOARD_PORT=5173  # Vite dev server port
# CARTETHYIA_DAEMON_PORT=12800    # Vite dev proxy target for the daemon API
