# Required runtime settings. PostgreSQL is required in every deployment; Redis does not replace it.
PORT=12800 # HTTP port.
NODE_ENV=development # Runtime mode.
DASHBOARD_DIST=./dist/dashboard # Dashboard asset directory.
LOG_LEVEL=debug # Log verbosity.
DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/cartethyia # Required PostgreSQL database.
CARTETHYIA_ENCRYPTION_KEY=replace-with-cartethyia-encryption-key # Encrypts provider credentials and API keys.
CARTETHYIA_PUBLIC_ORIGIN=http://localhost:12800 # Public URL for OAuth callbacks and console links.

# Optional settings. Use single_instance_local for one local gateway without Redis.
REDIS_MODE=normal
# REDIS_URL=redis://localhost:6379 # Redis server for normal coordination.
# CARTETHYIA_API_KEY= # Creates a default API key during first-boot setup.
# TRUSTED_PROXY_CIDRS= # Trust forwarded client-IP headers from these proxy ranges.
# CARTETHYIA_ALLOWED_NETWORKS= # Private CIDRs allowed for upstream connections.
# CARTETHYIA_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads # Payload capture directory.
# VITE_BACKEND_URL=http://127.0.0.1:12800 # Backend URL for dashboard development.

# Defaults and overrides. Uncomment only when the built-in default is not suitable.

# Database connection and lock limits.
# DATABASE_POOL_MAX=20 # Maximum database connections per process.
# DATABASE_STATEMENT_TIMEOUT_MS=30000 # Maximum statement runtime.
# DATABASE_IDLE_IN_TXN_TIMEOUT_MS=60000 # Maximum idle transaction time.
# DATABASE_LOCK_TIMEOUT_MS=5000 # Maximum lock wait time.

# Setup, request limits, memory warning, and graceful shutdown.
# CARTETHYIA_SETUP_MODE=auto # Native checks by default; docker starts Compose PostgreSQL and Redis.
# CARTETHYIA_SERVER_MAX_BODY_BYTES=8388608 # Maximum request body size.
# CARTETHYIA_SERVER_IDLE_TIMEOUT=60 # Idle connection timeout in seconds.
# CARTETHYIA_SHUTDOWN_DRAIN_WINDOW_MS=20000 # Time for active requests to finish.
# CARTETHYIA_MEMORY_LIMIT_BYTES=536870912 # Explicit memory warning limit.

# Telemetry retention, payload limits, and provider installation identity.
# CARTETHYIA_TELEMETRY_RETENTION_DAYS=30 # Metadata telemetry retention in days.
# CARTETHYIA_TELEMETRY_PAYLOAD_MAX_BYTES=33554432 # Combined full-capture limit; 32 MiB.
# CARTETHYIA_TELEMETRY_PAYLOAD_FILE_MAX_BYTES=268435456 # Backing file size limit.
# CARTETHYIA_TELEMETRY_PAYLOAD_RETENTION_MS=900000 # Payload retention time.
# CARTETHYIA_INSTALL_ID_DIR=./data/.cartethyia # Writable installation-id directory.

# Network and abuse policy.
# CARTETHYIA_ALLOW_PRIVATE_UPSTREAMS=true # Allow private upstream addresses.
# CARTETHYIA_MAX_REDIRECTS=3 # Maximum upstream redirects.
# IP_RATE_MAX_PER_WINDOW=240 # Requests per client IP in the rate window.
# CARTETHYIA_MODEL_STRIKE_THRESHOLD=10 # Invalid requests before an IP ban.
# CARTETHYIA_MODEL_STRIKE_WINDOW_MS=300000 # Strike expiry time.
# CARTETHYIA_MODEL_BAN_TTL_MS=3600000 # Invalid-model IP-ban duration.

# Upstream deadlines and fallback retry timing.
# CARTETHYIA_UPSTREAM_TIMEOUT_MS=120000 # Overall upstream request deadline.
# CARTETHYIA_STREAM_STALL_TIMEOUT_MS=360000 # Maximum stream silence.
# CARTETHYIA_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000 # Time to first visible chunk.
# CARTETHYIA_FALLBACK_RETRY_BASE_MS=100 # Minimum fallback retry delay.
# CARTETHYIA_FALLBACK_RETRY_CAP_MS=2000 # Maximum fallback retry delay.

# Account and proxy-pool cooldowns and socket limits.
# CARTETHYIA_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000 # Rate-limit cooldown.
# CARTETHYIA_ACCOUNT_QUOTA_COOLDOWN_MS=3600000 # Quota cooldown.
# CARTETHYIA_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000 # Model-capacity cooldown.
# CARTETHYIA_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000 # Temporary error cooldown.
# CARTETHYIA_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=60000 # Unclassified error cooldown.
# CARTETHYIA_POOL_COOLDOWN_MS=120000 # Proxy-pool failure cooldown.
# CARTETHYIA_PROXY_MAX_SOCKETS=100 # Maximum active proxy sockets.
# CARTETHYIA_PROXY_MAX_FREE_SOCKETS=20 # Maximum idle proxy sockets.

# Provider-specific overrides. Leave unset unless a different endpoint is required.
# CARTETHYIA_KIMI_OAUTH_HOST= # Kimi OAuth host override.
# CARTETHYIA_KIMI_QUOTA_BASE_URL= # Kimi quota API base URL override.
# CARTETHYIA_GITHUB_ENTERPRISE_DOMAIN= # Enterprise domain; empty uses github.com.
