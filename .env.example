# ── Server ──────────────────────────────────────────────────────────────────
PORT=12800
# Railway persistent volume: /app/data
DATA_DIR=./data
MAX_FLIGHTS_PER_IP=20
# Set true only behind a controlled reverse proxy such as Railway.
TRUST_PROXY=false
CACHE_MARKERS_ENABLED=true
OPENCODE_FREE_ACCESS=all

# ── Console and proxy access ────────────────────────────────────────────────
# Generate unique production secrets; do not commit real values.
CONSOLE_PASSWORD=change-me
CONSOLE_JWT_SECRET=replace-with-a-long-random-secret
# Keep this stable: it encrypts stored provider credentials.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional first proxy API key, created at boot.
BOOTSTRAP_PROXY_API_KEY=
BOOTSTRAP_PROXY_API_KEY_NAME=bootstrap

# ── Request transforms ──────────────────────────────────────────────────────
# Appended to every upstream request; this is server-owned, not user-editable.
CARTETHYIA_SYSTEM_PROMPT=""
RTK_ENABLED=false
RTK_MIN_CHARS=1500
RTK_MAX_REDUCTION_PERCENT=35

# ── Runtime retention ───────────────────────────────────────────────────────
# Runtime request/error logs are JSONL under DATA_DIR/logs.
# Store redacted payloads by default; only retain asset metadata, never asset bodies.
LOG_RETENTION_DAYS=14
ASSET_RETENTION_DAYS=7
TRACK_PAYLOADS=store
TRACK_ASSETS=meta
