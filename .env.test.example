# Disposable local test database. Never point this at production.
# The suites and `bun run test-db:check` read these names. DATABASE_URL is
# deliberately never a fallback, so a check cannot silently validate the
# working database.
CARTETHYIA_TEST_DATABASE_URL=postgres://cartethyia_test:cartethyia_test@127.0.0.1:55432/cartethyia_test
CARTETHYIA_TEST_REDIS_URL=redis://127.0.0.1:6379/15
