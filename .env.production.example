# =============================================================================
# Cartethyia — Production Environment
# Copy this file to .env, fill in the required values, and never commit it.
# =============================================================================

# ── Required — no safe defaults, must be set before first run ─────────────────
CONSOLE_PASSWORD=<strong-random-password>
CONSOLE_JWT_SECRET=<at-least-32-random-chars>

# ── Server ────────────────────────────────────────────────────────────────────
PORT=12800
DATA_DIR=/app/data

# Production: set to true when behind a trusted reverse proxy (Railway, Fly, etc.)
# This trusts X-Forwarded-For and X-Forwarded-Proto headers for IP/HTTPS detection.
TRUST_PROXY=true

# Allow at most N concurrent proxy requests per client IP (0 = unlimited).
MAX_FLIGHTS_PER_IP=20

# Comma-separated origins to allow for CORS on /v1/* endpoints.
# Leave empty to keep same-origin only (recommended for private deployments).
# CORS_ALLOWED_ORIGINS=

# Abort a stalled SSE stream after this many milliseconds of silence.
STREAM_STALL_TIMEOUT_MS=30000

# ── Proxy API key auth ────────────────────────────────────────────────────────
# Require callers to present a proxy API key on all /v1/* requests.
PROXY_AUTH_MODE=api_key

# Seed an initial key on first startup (leave empty to create via console UI).
# BOOTSTRAP_PROXY_API_KEY=<your-secret-key>
# BOOTSTRAP_PROXY_API_KEY_NAME=default

# ── Console ───────────────────────────────────────────────────────────────────
# CONSOLE_PATH=/console
# CONSOLE_ENABLED=true
CONSOLE_SESSION_TTL_HOURS=8

# ── Caching ───────────────────────────────────────────────────────────────────
CACHE_MARKERS_ENABLED=true

# ── Request transforms ────────────────────────────────────────────────────────
# RTK compresses token-heavy payloads — enable if you route to token-metered providers.
# RTK_ENABLED=false
# RTK_MIN_CHARS=1500
# RTK_MAX_REDUCTION_PERCENT=35

# ── Retention & tracking ──────────────────────────────────────────────────────
LOG_RETENTION_DAYS=14
ASSET_RETENTION_DAYS=7
# store: saves redacted payload files to DATA_DIR/payloads (searchable in console)
# meta:  saves only metadata (size, model, token counts)
# none:  no payload tracking
TRACK_PAYLOADS=store
TRACK_ASSETS=meta

# ── Path overrides (usually not needed) ──────────────────────────────────────
# DB_PATH=
# LOG_DIR=
# ASSET_DIR=
