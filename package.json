{
  "name": "cartethyia",
  "version": "2.2.0",
  "description": "A powerful, self-hosted reverse proxy for OpenAI- and Anthropic-compatible AI clients, powered by native Bun and Elysia. It serves both protocols from a single server, routes every model across any configured provider, and translates requests and responses in real time — streaming and prompt caching included. Underneath it runs a full delivery engine: per-account health tracking, quota and cooldown enforcement, automatic failover across pools and providers, usage accounting, and telemetry. Point OpenCode, Cline, Claude Code, Codex, or any compatible client at Cartethyia and it keeps its native protocol while the gateway absorbs every provider-specific difference behind it. Runs on embedded SQLite or external PostgreSQL with optional Redis coordination, ships as a global CLI with a system-tray console, and needs only Bun 1.4+ alongside Node.js/npm.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risunCode/Cartethyia.git"
  },
  "homepage": "https://github.com/risunCode/Cartethyia#readme",
  "bugs": {
    "url": "https://github.com/risunCode/Cartethyia/issues"
  },
  "keywords": [
    "ai",
    "gateway",
    "llm",
    "bun",
    "self-hosted"
  ],
  "bin": {
    "cartethyia": "scripts/cli/cli-launcher.cjs",
    "carte": "scripts/cli/carte-launcher.cjs"
  },
  "files": [
    "scripts/cli/",
    "scripts/shared/env.ts",
    "src/",
    "migrations/",
    "dist/dashboard/",
    "tray-assets/",
    ".env.example",
    "README.md"
  ],
  "workspaces": [
    "dashboard"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run dev:stack",
    "dev:watch": "bun run scripts/dev/supervisor.ts",
    "test": "bun run scripts/test/run.ts",
    "build": "bun run scripts/build/build.ts",
    "prepack": "bun run dashboard:build",
    "setup": "bun run scripts/cli/setup.ts",
    "start": "bun run scripts/operations/start-production.ts",
    "doctor": "bun run scripts/cli/doctor.ts",
    "restart": "bun run scripts/operations/restart.ts",
    "build:aot": "bun run scripts/build/aot.ts",
    "dev:stack": "concurrently -n BACKEND,DASHBOARD -c cyan,magenta --kill-others-on-fail \"bun run dev:backend\" \"bun run dashboard:dev\"",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun run scripts/test/run.ts --watch",
    "test-db:up": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "dev:backend": "bun run --hot src/main.ts",
    "dev:console-auth": "bun run scripts/dev/console-session.ts",
    "dev:visual-baseline": "bun run scripts/dev/visual-baseline.ts",
    "build:assets": "bun run scripts/build/assets/compress-assets.ts",
    "build:binary": "bun run scripts/build/binary.ts",
    "test:backend": "bun run scripts/test/run.ts --scope backend",
    "test-db:down": "docker compose -f docker-compose.test.yml down",
    "dashboard:dev": "bun run --cwd dashboard dev",
    "test-db:check": "bun run scripts/test/db-check.ts",
    "dashboard:test": "bun run scripts/test/run.ts --scope dashboard",
    "test-db:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "dashboard:build": "bun run --cwd dashboard build",
    "dashboard:typecheck": "bun run --cwd dashboard typecheck"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "drizzle-orm": "0.45.2",
    "elysia": "^2.0.0-beta.16",
    "exact-mirror": "^1.2.6",
    "impit": "^0.14.5",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks-proxy-agent": "^10.1.0",
    "systray2": "2.1.4",
    "typebox": "1.3.27",
    "undici": "^8.10.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/ws": "8.18.1",
    "bun-types": "1.4.0",
    "concurrently": "^10.0.5",
    "typescript": "5.9.2"
  }
}
