{
  "name": "cartethyia",
  "version": "1.0.7-alpha",
  "description": "OpenAI <-> Anthropic compat reverse proxy (Chat Completions, Responses, Messages) with prompt-cache passthrough and image decode.",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build --compile --minify --bytecode --target bun --outfile dist/cartethyia src/server.ts",
    "test": "bun test test/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "elysia": "^1.4.29",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
