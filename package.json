{
  "name": "cartethyia",
  "version": "2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "dashboard"
  ],
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun run dev:stack",
    "start": "bun run scripts/ops-start-binary.ts",
    "dev:stack": "concurrently -n BACKEND,DASHBOARD -c cyan,magenta --kill-others-on-fail \"bun run dev:backend\" \"bun run dashboard:dev\"",
    "build": "bun run dashboard:build && bun run build:aot && bun run build:binary",
    "setup": "bun run scripts/ops-setup.ts",
    "doctor": "bun run scripts/ops-doctor.ts",
    "build:aot": "bun run scripts/build-aot.ts",
    "build:binary": "bun run scripts/build-binary.ts",
    "typecheck": "tsc --noEmit",
    "generate:usage-periods": "bun run scripts/ci-generate-usage-periods.ts",
    "dev:backend": "bun run --hot src/main.ts",
    "dashboard:dev": "bun run --cwd dashboard dev",
    "check:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/ci-check-coverage.ts",
    "dashboard:test": "bun run --cwd dashboard test",
    "test": "bun run scripts/ops-run-tests.ts",
    "test:contracts": "bun run scripts/ops-run-tests.ts test/contracts",
    "dashboard:build": "bun run --cwd dashboard build",
    "test:integration": "bun run scripts/ops-run-tests.ts test/integration",
    "dashboard:typecheck": "bun run --cwd dashboard typecheck"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "drizzle-orm": "0.45.2",
    "elysia": "^2.0.0-beta.16",
    "exact-mirror": "^1.2.6",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks-proxy-agent": "^10.1.0",
    "typebox": "1.3.27",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "bun-types": "1.4.0",
    "concurrently": "^10.0.5",
    "typescript": "5.9.2"
  }
}
