{
  "name": "cartethyia",
  "version": "2.2.0",
  "description": "A self-hosted multi-provider AI gateway with a Bun-powered CLI.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risunCode/Cartethyia.git"
  },
  "homepage": "https://github.com/risunCode/Cartethyia#readme",
  "bugs": {
    "url": "https://github.com/risunCode/Cartethyia/issues"
  },
  "keywords": [
    "ai",
    "gateway",
    "llm",
    "bun",
    "self-hosted"
  ],
  "bin": {
    "cartethyia": "scripts/commands/cli-launcher.cjs"
  },
  "files": [
    "scripts/commands/cli-launcher.cjs",
    "scripts/commands/cli.ts",
    "scripts/commands/setup.ts",
    "scripts/internal/env.ts",
    "src/",
    "migrations/",
    "dist/dashboard/",
    "tray-assets/",
    ".env.example",
    "README.md"
  ],
  "workspaces": [
    "dashboard"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run dev:stack",
    "dev:watch": "bun run scripts/dev/supervisor.ts",
    "test": "bun run scripts/ci-run-tests.ts",
    "build": "bun run dashboard:build && bun run build:aot && bun run build:binary",
    "prepack": "bun run dashboard:build",
    "setup": "bun run scripts/commands/setup.ts",
    "start": "bun run scripts/commands/start-production.ts",
    "doctor": "bun run scripts/commands/doctor.ts",
    "restart": "bun run scripts/commands/restart.ts",
    "build:aot": "bun run scripts/build/aot.ts",
    "dev:stack": "concurrently -n BACKEND,DASHBOARD -c cyan,magenta --kill-others-on-fail \"bun run dev:backend\" \"bun run dashboard:dev\"",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun run scripts/ci-run-tests.ts --watch",
    "test-db:up": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "dev:backend": "bun run --hot src/main.ts",
    "dev:console-auth": "bun run scripts/dev/console-session.ts",
    "dev:visual-baseline": "bun run scripts/dev/visual-baseline.ts",
    "build:assets": "bun run scripts/build/compress-assets.ts",
    "build:binary": "bun run scripts/build/binary.ts",
    "test:backend": "bun run scripts/ci-run-tests.ts --scope backend",
    "test-db:down": "docker compose -f docker-compose.test.yml down",
    "dashboard:dev": "bun run --cwd dashboard dev",
    "test-db:check": "bun run scripts/commands/test-db-check.ts",
    "dashboard:test": "bun run scripts/ci-run-tests.ts --scope dashboard",
    "test-db:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "dashboard:build": "bun run --cwd dashboard build",
    "dashboard:typecheck": "bun run --cwd dashboard typecheck"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "drizzle-orm": "0.45.2",
    "elysia": "^2.0.0-beta.16",
    "exact-mirror": "^1.2.6",
    "impit": "^0.14.5",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks-proxy-agent": "^10.1.0",
    "systray2": "2.1.4",
    "typebox": "1.3.27",
    "undici": "^8.10.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/ws": "8.18.1",
    "bun-types": "1.4.0",
    "concurrently": "^10.0.5",
    "typescript": "5.9.2"
  }
}
